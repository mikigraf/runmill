{
  "name": "runmill",
  "version": "0.1.0",
  "description": "Loop orchestrator daemon for autonomous software engineering. Turns backlog issues into reviewed pull requests.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.15.0",
  "bin": {
    "runmill": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "dist-native",
    "docs",
    "runmill.schema.json",
    "examples/quickstart",
    "examples/eval",
    "examples/asf-worker"
  ],
  "scripts": {
    "build": "npm run build:native && tsc -p tsconfig.build.json",
    "build:native": "node scripts/build-ctxlane-native.mjs",
    "dev": "tsx src/cli/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --max-warnings 0",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run docs:check",
    "package:check": "npm run build && node scripts/check-package.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "docs:errors": "tsx scripts/gen-error-docs.ts",
    "docs:check": "tsx scripts/gen-error-docs.ts --check",
    "verify:linux": "./scripts/verify-linux.sh",
    "verify:ctxlane-fixtures": "tsx scripts/check-ctxlane-fixture-freshness.ts",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run check && npm run package:check"
  },
  "dependencies": {
    "@linear/sdk": "39.2.1",
    "@octokit/rest": "21.1.1",
    "@opentui/core": "0.5.1",
    "ajv": "8.20.0",
    "better-sqlite3": "13.0.3",
    "commander": "13.1.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "tsx": "4.23.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikigraf/runmill.git"
  },
  "bugs": {
    "url": "https://github.com/mikigraf/runmill/issues"
  },
  "homepage": "https://github.com/mikigraf/runmill#readme",
  "keywords": [
    "ai",
    "coding-agent",
    "automation",
    "cli",
    "tui",
    "daemon"
  ]
}
