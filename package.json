{
  "name": "runmill",
  "version": "0.1.0",
  "description": "Loop orchestrator daemon for autonomous software engineering. Turns backlog issues into reviewed pull requests.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "runmill": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "docs",
    "runmill.schema.json",
    "assets",
    "examples/quickstart",
    "examples/eval"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --max-warnings 0",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "docs:errors": "tsx scripts/gen-error-docs.ts",
    "docs:check": "tsx scripts/gen-error-docs.ts --check",
    "verify:linux": "./scripts/verify-linux.sh",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm run test:coverage && npm run docs:check"
  },
  "dependencies": {
    "@linear/sdk": "39.2.1",
    "@octokit/rest": "21.1.1",
    "@opentui/core": "0.5.1",
    "better-sqlite3": "11.10.0",
    "commander": "13.1.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.39.5",
    "tsx": "4.23.9",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikigraf/runmill.git"
  },
  "bugs": {
    "url": "https://github.com/mikigraf/runmill/issues"
  },
  "homepage": "https://github.com/mikigraf/runmill#readme",
  "keywords": [
    "ai",
    "coding-agent",
    "automation",
    "cli",
    "tui",
    "daemon"
  ]
}
