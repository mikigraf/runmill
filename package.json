{
  "name": "runmill",
  "version": "0.1.0",
  "description": "A control plane for autonomous software engineering. Turns a backlog into governed pull requests.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "runmill": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "runmill.schema.json",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --max-warnings 0"
  },
  "dependencies": {
    "@linear/sdk": "^39.0.0",
    "@octokit/rest": "^21.1.1",
    "ajv": "^8.17.1",
    "better-sqlite3": "^11.8.1",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "yaml": "^2.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "@vitest/coverage-v8": "^3.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
