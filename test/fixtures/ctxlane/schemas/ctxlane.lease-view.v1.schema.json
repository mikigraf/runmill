{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mikigraf/ctxlane/main/schemas/ctxlane.lease-view.v1.schema.json",
  "title": "ctxlane capability-free lease view v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "lease_id",
    "status",
    "tenant_id",
    "work_order_id",
    "work_order_digest",
    "run_id",
    "attempt_id",
    "role",
    "provider",
    "profile_uid",
    "profile_ref",
    "repository",
    "workspace_id",
    "environment",
    "caller_subject",
    "host_identity",
    "worker_identity",
    "principal_ref",
    "workspace_ref",
    "auth_mode",
    "issued_at",
    "expires_at",
    "maximum_expires_at",
    "isolation",
    "effective_policy_digest",
    "refusal_code",
    "reason_code"
  ],
  "properties": {
    "schema": { "const": "ctxlane.lease-view/v1" },
    "lease_id": { "type": "string", "pattern": "^lease_[A-Za-z0-9]{26}$" },
    "status": {
      "enum": ["requested", "active", "renewing", "closed", "revoked", "expired", "refused", "error"]
    },
    "tenant_id": { "$ref": "#/$defs/label" },
    "work_order_id": { "$ref": "#/$defs/label" },
    "work_order_digest": { "$ref": "#/$defs/digest" },
    "run_id": { "$ref": "#/$defs/label" },
    "attempt_id": { "$ref": "#/$defs/label" },
    "role": { "enum": ["implementer", "local-reviewer", "pr-reviewer"] },
    "provider": { "enum": ["claude", "codex"] },
    "profile_uid": { "type": "string", "pattern": "^profile_[A-Za-z0-9]{26}$" },
    "profile_ref": { "type": "string", "pattern": "^(claude|codex):[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$" },
    "workspace_id": { "$ref": "#/$defs/label" },
    "environment": { "$ref": "#/$defs/label" },
    "caller_subject": { "type": "string", "pattern": "^caller:[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
    "host_identity": { "type": "string", "pattern": "^host:[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
    "worker_identity": { "oneOf": [{ "type": "string", "pattern": "^worker:[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" }, { "type": "null" }] },
    "principal_ref": { "oneOf": [{ "type": "string", "pattern": "^(user|service-account):[A-Za-z0-9][A-Za-z0-9_.@-]{0,127}$" }, { "type": "null" }] },
    "workspace_ref": { "oneOf": [{ "type": "string", "pattern": "^(claude-organization|chatgpt-workspace):[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" }, { "type": "null" }] },
    "auth_mode": { "oneOf": [{ "enum": ["wif", "subscription-token", "api-key", "chatgpt-oauth", "access-token"] }, { "type": "null" }] },
    "issued_at": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
    "maximum_expires_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
    "isolation": { "oneOf": [{ "enum": ["credential-isolated", "per-lease-isolated", "unproven", "copied-credential-development"] }, { "type": "null" }] },
    "effective_policy_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "refusal_code": { "oneOf": [{ "type": "string", "pattern": "^[a-z0-9-]{1,64}$" }, { "type": "null" }] },
    "reason_code": { "oneOf": [{ "type": "string", "pattern": "^[a-z0-9-]{1,64}$" }, { "type": "null" }] }
  },
  "$defs": {
    "label": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
  }
}
